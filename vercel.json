{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/transcribe.js": {
      "maxDuration": 300
    },
    "api/transcription-jobs/process.js": {
      "maxDuration": 300
    },
    "api/notes.js": {
      "maxDuration": 120
    },
    "api/chat.js": {
      "maxDuration": 120
    },
    "api/health.js": {
      "maxDuration": 120
    },
    "api/bot.js": {
      "maxDuration": 60
    },
    "api/followup.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/transcription-jobs/process",
      "schedule": "0 3 * * *"
    }
  ]
}
